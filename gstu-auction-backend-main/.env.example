## Backend environment example (DO NOT COMMIT actual secrets)
# MongoDB connection string (use MongoDB Atlas or another provider)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/gstu_auction?retryWrites=true&w=majority
MONGO_URI=

# Cloudinary credentials (optional for image uploads/wipe)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port (Render/hosts usually set this automatically)
PORT=5000

NODE_ENV=production
