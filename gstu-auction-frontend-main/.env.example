## Frontend (Vite) environment example
# Use VITE_ prefix for variables exposed to client-side code.
# Set API host (include protocol), e.g. http://localhost:5000 or https://backend.example.com
VITE_API_URL=

# Optional: explicit socket URL (ws:// or wss://). If empty, VITE_API_URL is used for sockets.
VITE_SOCKET_URL=

# Cloudinary client-side info if you need direct unsigned uploads
VITE_CLOUDINARY_CLOUD_NAME=

NODE_ENV=production
